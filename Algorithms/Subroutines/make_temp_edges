#--------------------------------------------------------------
# make_temp_edges : build temp_edges for BOTH entirely-free and
# partially-fixed group orders.
#   - always exclude the non-proxy cross-group pairs (pc_set)
#   - if partially fixed, ALSO exclude the proxy pair (from
#     go_set) of the constrained group pair: its group-level
#     factor is constant (I == 1), confounded with the intercept.
#--------------------------------------------------------------
make_temp_edges <- function(groups, edges, group_order,
                            tilde_edges = NULL) {
  res <- pai_cons_set_unfixed(groups, group_order)
  pc  <- res$pc_set
  gs  <- res$go_set
  if (is.null(pc)) pc <- matrix(numeric(0), 0, 2)
  if (is.null(gs)) gs <- matrix(numeric(0), 0, 2)
  if (is.vector(pc)) pc <- matrix(pc, ncol = 2)
  if (is.vector(gs)) gs <- matrix(gs, ncol = 2)
  
  temp <- rbind(edges, pc)
  
  if (!is.null(tilde_edges)) {
    grp_of <- function(comp) {
      for (k in seq_along(groups)) if (comp %in% groups[[k]]) return(k)
      NA
    }
    hit <- apply(gs, 1, function(e)
      setequal(c(grp_of(e[1]), grp_of(e[2])),
               c(tilde_edges[1], tilde_edges[2])))
    if (any(hit)) temp <- rbind(temp, gs[hit, , drop = FALSE])
  }
  temp
}

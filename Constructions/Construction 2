############################################################
## Construction 2 for COofA-OAs with free group order
############################################################

## ---------------------------------------------------------
## 1. Basic utilities
## ---------------------------------------------------------

## Generate all permutations of a vector
all_perms <- function(x) {
  if (length(x) == 1) {
    return(matrix(x, nrow = 1))
  }
  out <- list()
  idx <- 1
  for (i in seq_along(x)) {
    sub <- all_perms(x[-i])
    out[[idx]] <- cbind(x[i], sub)
    idx <- idx + 1
  }
  do.call(rbind, out)
}

## Check strength-two mixed-level OA
check_OA_strength2 <- function(OA, levels_vec) {
  q <- ncol(OA)
  ok <- TRUE
  
  for (a in 1:(q - 1)) {
    for (b in (a + 1):q) {
      tab <- table(
        factor(OA[, a], levels = 1:levels_vec[a]),
        factor(OA[, b], levels = 1:levels_vec[b])
      )
      target <- nrow(OA) / (levels_vec[a] * levels_vec[b])
      
      if (!all(tab == target)) {
        ok <- FALSE
        cat("Failed OA columns:", a, b, "\n")
        print(tab)
      }
    }
  }
  
  ok
}

## ---------------------------------------------------------
## 2. Construction 2
## ---------------------------------------------------------

construction_2 <- function(D_list, Dtilde, OA) {
  ## D_list: list(D1, ..., D_ntilde)
  ## Dtilde: OofA-OA on group indices 1,...,ntilde
  ## OA: columns are (r0, r1, ..., r_ntilde)
  
  n_OA <- nrow(OA)
  ntilde <- length(D_list)
  m <- sum(sapply(D_list, ncol))
  
  if (ncol(OA) != ntilde + 1) {
    stop("The OA must have ntilde + 1 columns: r0, r1, ..., r_ntilde.")
  }
  
  D <- matrix(NA, nrow = n_OA, ncol = m)
  
  for (r in seq_len(n_OA)) {
    r0 <- OA[r, 1]
    group_order <- Dtilde[r0, ]
    
    selected_rows <- vector("list", ntilde)
    
    for (k in seq_len(ntilde)) {
      rk <- OA[r, k + 1]
      selected_rows[[k]] <- D_list[[k]][rk, ]
    }
    
    row_vec <- c()
    for (pos in seq_len(ntilde)) {
      group_id <- group_order[pos]
      row_vec <- c(row_vec, selected_rows[[group_id]])
    }
    
    D[r, ] <- row_vec
  }
  
  D
}

## ---------------------------------------------------------
## 3. Model matrix under free group order
## ---------------------------------------------------------

make_X_free_group_order <- function(D, groups) {
  ## Model: intercept + intra-group PWO factors + group-order PWO factors
  
  n <- nrow(D)
  X <- matrix(1, nrow = n, ncol = 1)
  col_names <- "Intercept"
  
  ## Intra-group PWO factors
  for (g_id in seq_along(groups)) {
    g <- groups[[g_id]]
    
    if (length(g) >= 2) {
      pairs <- combn(g, 2)
      
      for (a in seq_len(ncol(pairs))) {
        i <- pairs[1, a]
        j <- pairs[2, a]
        z <- numeric(n)
        
        for (r in seq_len(n)) {
          pos_i <- which(D[r, ] == i)
          pos_j <- which(D[r, ] == j)
          z[r] <- ifelse(pos_i < pos_j, 1, -1)
        }
        
        X <- cbind(X, z)
        col_names <- c(col_names, paste0("I", i, j))
      }
    }
  }
  
  ## Group-order PWO factors
  if (length(groups) >= 2) {
    group_pairs <- combn(seq_along(groups), 2)
    
    for (a in seq_len(ncol(group_pairs))) {
      g1 <- group_pairs[1, a]
      2 <- group_pairs[2, a]
      z <- numeric(n)
      
      for (r in seq_len(n)) {
        pos_g1 <- which(D[r, ] %in% groups[[g1]])
        pos_2 <- which(D[r, ] %in% groups[[2]])
        
        ## Since designs are block-concatenated by groups,
        ## this checks whether group g1 appears before group 2.
        z[r] <- ifelse(max(pos_g1) < min(pos_2), 1, -1)
      }
      
      X <- cbind(X, z)
      col_names <- c(col_names, paste0("G", g1, "G", 2))
    }
  }
  
  colnames(X) <- col_names
  X
}

norm_info_free <- function(D, groups) {
  X <- make_X_free_group_order(D, groups)
  crossprod(X) / nrow(X)
}

D_eff <- function(MD, MF) {
  p <- ncol(MD)
  logdet_MD <- determinant(MD, logarithm = TRUE)$modulus[1]
  logdet_MF <- determinant(MF, logarithm = TRUE)$modulus[1]
  as.numeric(exp((logdet_MD - logdet_MF) / p))
}

## ---------------------------------------------------------
## 4. Full design with free group order
## ---------------------------------------------------------

make_full_free_group_design <- function(groups) {
  ntilde <- length(groups)
  
  P_list <- lapply(groups, all_perms)
  group_orders <- all_perms(seq_len(ntilde))
  
  within_grid <- expand.grid(lapply(P_list, function(P) seq_len(nrow(P))))
  
  D_full_list <- list()
  idx <- 1
  
  for (go_r in seq_len(nrow(group_orders))) {
    group_order <- group_orders[go_r, ]
    
    for (r in seq_len(nrow(within_grid))) {
      row_vec <- c()
      
      for (pos in seq_len(ntilde)) {
        g_id <- group_order[pos]
        row_index <- within_grid[r, g_id]
        row_vec <- c(row_vec, P_list[[g_id]][row_index, ])
      }
      
      D_full_list[[idx]] <- row_vec
      idx <- idx + 1
    }
  }
  
  do.call(rbind, D_full_list)
}

## ---------------------------------------------------------
## 5. Example:  m = 8, groups = (3,5)
## ---------------------------------------------------------

groups <- list(
  G1 = 1:3,
  2 = 4:8
)

## D1: OofA-OA(6,3), full 3! design
D1 <- all_perms(1:3)

## D2: OofA-OA(12,5), shifted to labels 4,5,6,7,8
D2_base <- rbind(
  c(1, 2, 4, 5, 3),
  c(1, 3, 4, 5, 2),
  c(2, 1, 5, 3, 4),
  c(2, 3, 5, 1, 4),
  c(3, 1, 5, 2, 4),
  c(3, 2, 4, 5, 1),
  c(4, 1, 2, 3, 5),
  c(4, 3, 2, 1, 5),
  c(4, 5, 2, 3, 1),
  c(5, 1, 4, 3, 2),
  c(5, 2, 4, 1, 3),
  c(5, 3, 4, 1, 2)
)

D2 <- D2_base + 3

## Dtilde: OofA-OA(2,2) on group indices {1,2}
Dtilde <- rbind(
  c(1, 2),
  c(2, 1)
)

## OA(72; 2^1 6^1 12^1; 2)
## Columns: r0 for Dtilde, r1 for D1, r2 for D2.
grid_6_12 <- expand.grid(
  r1 = 1:6,
  r2 = 1:12
)

OA_72_2_6_12 <- cbind(
  r0 = ((grid_6_12$r1 - 1 + grid_6_12$r2 - 1) %% 2) + 1,
  r1 = grid_6_12$r1,
  r2 = grid_6_12$r2
)

cat("Check OA(72;2^1 6^1 12^1;2):\n")
print(check_OA_strength2(OA_72_2_6_12, c(2, 6, 12)))

## Apply Construction 2
D_2 <- construction_2(
  D_list = list(D1, D2),
  Dtilde = Dtilde,
  OA = OA_72_2_6_12
)

cat("Dimension of constructed design D_2:\n")
print(dim(D_2))

## ---------------------------------------------------------
## 6. Verify information-matrix equality
## ---------------------------------------------------------

D_full <- make_full_free_group_design(groups)

M_D <- norm_info_free(D_2, groups)
M_F <- norm_info_free(D_full, groups)

max_diff <- max(abs(M_D - M_F))
D_eff_value <- D_eff(M_D, M_F)

cat("\nVerification results for Construction 2, Table t2 Case 14:\n")
cat("Run size of constructed design n =", nrow(D_2), "\n")
cat("Run size of full design N =", nrow(D_full), "\n")
cat("Number of parameters p =", ncol(M_D), "\n")
cat("max |M_D - M_F| =", max_diff, "\n")
cat("D_eff =", D_eff_value, "\n")


n_cores <- 24

#  cluster
cl <- makeCluster(n_cores)
clusterEvalQ(cl, {
  library(gtools)
  library(igraph)
  load("D:/consdesign.R")
  load("D:/consregdesign.R")
  load("D:/pai_cons_set.R")
  load("D:/perturb_topo.R")
  load("D:/ta_kahn_random.R")
  load("D:/topo_sort_kahn_random.R")
  load("D:/transitive_reduction.R")
})
#setups
num_groups <- c(3,5)
m <- sum(num_groups)
edges <- pai_cons_set(num_groups)
g <- graph_from_edgelist(edges, directed = TRUE)
g_minimal <- transitive_reduction(g) # 传递规约
cons <-as_edgelist(g_minimal)  # 输出最小边集合 
num_runs <- sum(num_groups*(num_groups-1)/2)+1
num_seq <- 2000
num_rounds <- num_seq /2
ntotal <- 100
# parallel 
final.out.putfig_35 <- parLapply(cl, 1:ntotal, function(x){
  set.seed(x)
  final_design <- ta_kahn_random(m,cons,edges,num_runs,num_seq,num_rounds)
  return(final_design)
})
...
# 关闭 cluster
stopCluster(cl)
save.image("D:/Table 1 (Cases 1-13).RData")

